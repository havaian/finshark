# Backend runtime env
BACKEND_PORT=3001
FRONTEND_PORT=3001
NODE_ENV=development

# Postgres connection (your external DB, version 15.7 assumed)
DATABASE_URL=postgres://user:password@host:5432/finshark

# Postgres connection pool tuning (optional). Defaults shown; unset = default.
# Raise PG_POOL_MAX under higher concurrency (watch your DB's max_connections).
PG_POOL_MAX=10
PG_IDLE_TIMEOUT=30

# Directory for user-uploaded files (payment slips). Relative paths resolve
# against the backend working directory; absolute paths are used as-is.
# For local (non-Docker) dev the default ./uploads is fine. In Docker this is
# OVERRIDDEN to /uploads by docker-compose (a root-level path backed by the
# 'uploads' named volume, pre-created nodeapp-owned in the Dockerfile so the
# container can write there). You don't normally need to set this for Docker.
UPLOADS_DIR=./uploads

# CORS origin for the frontend dev server
CORS_ORIGIN=http://localhost:5173

# JWT secrets - generate with `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
# Use DIFFERENT values for access and refresh.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_hex_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_hex_string

# Token lifetimes (zeit/ms format)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# bcrypt cost factor (10 is fine for dev; 12 for prod)
BCRYPT_ROUNDS=10

# ---- Admin bootstrap ----
# Email of the user who should be promoted to admin on backend startup.
# Idempotent: if the user already exists and is admin, this is a no-op.
# If the user doesn't exist yet, nothing happens - they need to sign in once
# (creating their account), then the next backend restart will promote them.
# Leave blank to disable; first admin can also be set via SQL or by another admin
# from the admin users page.
BOOTSTRAP_ADMIN_EMAIL=

# ---- LLM grading (short-answer questions) ----
# Provider: 'none' disables LLM grading (falls back to exact-match).
#           'openai' uses OPENAI_API_KEY + OPENAI_MODEL.
#           'anthropic' uses ANTHROPIC_API_KEY + ANTHROPIC_MODEL.
LLM_PROVIDER=none

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Per-user daily grade cap. Above this we fall back to exact-match for the rest of the day.
LLM_GRADES_PER_USER_PER_DAY=200

# Hard timeout for a single LLM grading call (ms). If exceeded, fall back to exact-match.
LLM_GRADE_TIMEOUT_MS=10000

# ---- LLM question generation (admin-only feature) ----
# Used by the "Generate questions" button in the admin Questions page.
# Requires ANTHROPIC_API_KEY above to be set; the generation feature is
# unavailable (returns 503) if the key is empty.
#
# Override model if you want a different one for generation than for grading
# (generation benefits from a more capable model; grading is fine with Haiku).
# Default if unset: claude-sonnet-4-5-20250929.
LLM_GENERATION_MODEL=

# Generation calls can run long (10 bilingual questions ≈ 30-60s). Adjust the
# timeout here if you see frequent timeouts. Milliseconds; default 90000.
LLM_GENERATION_TIMEOUT_MS=90000

# ---- Email (reminders & transactional) ----
# Mode: 'log' = no real send, body printed to backend console (dev default).
#       'smtp' = real send via nodemailer using SMTP_* below.
EMAIL_MODE=log

# Required when EMAIL_MODE=smtp
SMTP_HOST=mail.example.com
SMTP_PORT=587

# Optional: leave SMTP_SECURE blank to auto-infer from port (true for 465, else false).
# Override explicitly if your host requires it.
SMTP_SECURE=

# Optional: auth. Some internal/relay setups don't require credentials.
SMTP_USER=
SMTP_PASS=

# Optional: set to 'false' ONLY if your SMTP server uses a self-signed certificate.
# Strict TLS verification is the default and what you want.
SMTP_TLS_REJECT_UNAUTHORIZED=true

EMAIL_FROM=Finshark <reminders@example.com>

# Public URL of the frontend; used in email bodies (CTA + unsubscribe).
APP_PUBLIC_URL=http://localhost:5173

# Secret for signing one-click unsubscribe links. MUST be a long random hex string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=replace_me_with_a_long_random_hex_string

# Cron expression (server-local TZ). Default: hourly - each run emails users
# whose `reminder_hour_local` matches the current wall-clock hour in their
# IANA timezone. Leave blank to use the default. Override with a single-hour
# expression (e.g. "0 18 * * *") combined with allHours=true via the admin
# trigger to send everyone at one fixed time regardless of preference.
# Empty/unset = use the default. Set to an impossible cron expression to disable.
REMINDER_CRON=0 * * * *

# Base URL for the NestJS API (note the /api prefix is set by Nest globally)
VITE_API_BASE_URL=http://localhost:3001/api
